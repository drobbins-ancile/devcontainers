{
	"name": "Python Dev Container",
	"image": "mcr.microsoft.com/devcontainers/python:1-3.13-bullseye",
	"features": {
		"ghcr.io/devcontainers/features/aws-cli:1": {},
		"ghcr.io/devcontainers/features/docker-in-docker:2": {},
		"ghcr.io/devcontainers/features/node:1": {},
		"ghcr.io/devcontainers-extra/features/ruff:1": {},
		"ghcr.io/devcontainers/features/github-cli:1": {},
		"ghcr.io/devcontainers-extra/features/uv:1": {}
	},
	"mounts": [
		"source=/var/run/docker.sock,target=/var/run/docker-host.sock,type=bind",
		"source=${localEnv:HOME}/.aws,target=/home/vscode/.aws,type=bind,consistency=cached"
	],
	"postCreateCommand": "grep -v '^::1' /etc/hosts > /tmp/hosts.tmp && cat /tmp/hosts.tmp > /etc/hosts && rm /tmp/hosts.tmp",
	"postStartCommand": "git config --global --add safe.directory ${containerWorkspaceFolder} && npm install -g @anthropic-ai/claude-code",
	"containerEnv": {
		"ANTHROPIC_MODEL": "opus",
		"AWS_PROFILE": "SDIGRELEASENOMFA" // Set your AWS profile name here
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"GitHub.copilot",
				"GitHub.vscode-pull-request-github",
				"ms-python.python",
				"ms-python.vscode-pylance",
				"ms-python.pylint",
				"amazonwebservices.aws-toolkit-vscode",
				"docker.docker",
				"charliermarsh.ruff",
				"meta.pyrefly"
			],
			"settings": {
				"files.trimTrailingWhitespace": true,
				"python.formatting.provider": "ruff",
				"editor.formatOnPaste": false,
				"editor.formatOnSave": true,
				"editor.formatOnType": true,
				"editor.defaultFormatter": "charliermarsh.ruff",
				"python.linting.enabled": true,
				"python.linting.pylintEnabled": true,
				"python.linting.pylintArgs": [
					"--source-roots=./ $(git ls-files '*.py')"
				],
				"[markdown]": {
				"files.trimTrailingWhitespace": false
				},
				"terminal.integrated.defaultProfile.osx": "zsh"
			}
		}
	}
}
